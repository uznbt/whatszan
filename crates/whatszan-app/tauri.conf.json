{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsZan",
  "version": "2.0.0",
  "identifier": "org.uznbt.whatszan",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Unofficial WhatsApp desktop client for Linux and Windows",
    "longDescription": "WhatsZan is an unofficial WhatsApp Web client for Linux and Windows, written in Rust with Tauri 2.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
