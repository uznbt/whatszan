{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the WhatsApp webview and the local settings window.",
  "windows": ["main", "settings", "screen-picker", "popup-*"],
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*",
      "https://*.whatsapp.com/*",
      "https://*.whatsapp.net/*"
    ]
  },
  "permissions": [
    "core:default",
    "default"
  ]
}
